<!doctype html>
<html lang="fi">
<head>
<meta charset="utf-8">
<title>{{ doc_type_label }} {{ number }}</title>
<style>
{% include "_reset.css.j2" %}
body { font-family: {{ font_family }}; font-size: 9.5pt; color: #111; }
.header { border-bottom: 1px solid #000; padding-bottom: 6pt; margin-bottom: 10pt; height: 130px; }
.company-name { font-size: 13pt; font-weight: bold; letter-spacing: -.02em; }
.company-addr { margin-top: 2pt; font-size: 8.5pt; }
.meta-line { margin-top: 8pt; font-size: 9pt; }
.meta-line span { display: inline-block; margin-right: 18pt; }
.buyer-block { margin-bottom: 10pt; font-size: 9pt; }
table.lines { font-size: 8.8pt; }
table.lines th, table.lines td { padding: 4pt 4pt; border-bottom: 1px dotted #999; text-align: left; }
table.lines thead { display: table-header-group; }
table.lines th { border-bottom: 1px solid #000; font-weight: bold; }
table.lines td.num, table.lines th.num { text-align: right; font-variant-numeric: tabular-nums; }
tr { page-break-inside: avoid; }
.totals-wrap { margin-top: 10pt; height: 100px; }
.totals-box { width: 240px; margin-left: auto; font-size: 9pt; }
.totals-box div { display: flex; justify-content: space-between; padding: 1pt 0; }
.totals-box .gross { font-weight: bold; border-top: 1px solid #000; margin-top: 3pt; padding-top: 3pt; }
.footer { margin-top: 16pt; border-top: 1px dotted #999; padding-top: 6pt; font-size: 8pt; }
.footer div { margin-bottom: 2pt; }
</style>
</head>
<body>
  <div class="header">
    <div class="company-name">{{ supplier.name }}</div>
    <div class="company-addr">{{ supplier.street }}, {{ supplier.postcode }} {{ supplier.city }} -- {{ labels.business_id }} {{ supplier.business_id }} -- {{ labels.vat_id }} {{ supplier.vat_id }}</div>
    <div class="meta-line">
      <span><b>{{ doc_type_label }} {{ number }}</b></span>
      <span>{{ labels.issue_date }} {{ issue_date }}</span>
      {% if due_date %}<span>{{ labels.due_date }} {{ due_date }}</span>{% endif %}
      {% if reference_value %}<span>{{ labels.reference }} {{ reference_value }}</span>{% endif %}
      {% if po_number %}<span>{{ labels.po_number }} {{ po_number }}</span>{% endif %}
      {% if original_invoice_number %}<span>{{ labels.original_invoice }} {{ original_invoice_number }}</span>{% endif %}
    </div>
  </div>

  <div class="buyer-block">
    {{ buyer.name }}, {{ buyer.street }}, {{ buyer.postcode }} {{ buyer.city }} ({{ labels.business_id }} {{ buyer.business_id }})
    {% if buyer.vat_id %}({{ labels.vat_id }} {{ buyer.vat_id }}){% endif %}
  </div>

  <table class="lines">
    <thead><tr>
      <th>{{ labels.description }}</th>
      <th class="num">{{ labels.quantity }}</th>
      <th>{{ labels.unit }}</th>
      <th class="num">{{ labels.unit_price }}</th>
      <th class="num">{{ labels.line_total }}</th>
    </tr></thead>
    <tbody>
      {% for line in page1_lines %}
      <tr>
        <td>{{ line.description }}</td>
        <td class="num">{{ line.quantity }}</td>
        <td>{{ line.unit }}</td>
        <td class="num">{{ line.unit_price }}</td>
        <td class="num">{{ line.line_total }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if page2_lines %}
  <div class="page-break-before">
    <div class="continuation-note">{{ doc_type_label }} {{ number }} ({{ labels.continued }})</div>
    <table class="lines">
      <thead><tr>
        <th>{{ labels.description }}</th>
        <th class="num">{{ labels.quantity }}</th>
        <th>{{ labels.unit }}</th>
        <th class="num">{{ labels.unit_price }}</th>
        <th class="num">{{ labels.line_total }}</th>
      </tr></thead>
      <tbody>
        {% for line in page2_lines %}
        <tr>
          <td>{{ line.description }}</td>
          <td class="num">{{ line.quantity }}</td>
          <td>{{ line.unit }}</td>
          <td class="num">{{ line.unit_price }}</td>
          <td class="num">{{ line.line_total }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="totals-wrap">
    <div class="totals-box">
      <div><span>{{ labels.net }}</span><span>{{ totals.net }}</span></div>
      <div><span>{{ labels.vat }} {{ vat_summary[0].rate }} %</span><span>{{ totals.vat }}</span></div>
      <div class="gross"><span>{{ labels.gross }}</span><span>{{ totals.gross }} {{ currency_suffix }}</span></div>
    </div>
  </div>

  <div class="footer">
    {% if payment_terms_label %}<div>{{ labels.payment_terms }}: {{ payment_terms_label }} -- {{ labels.reference }}: {{ reference_value }}</div>{% endif %}
    <div>{{ labels.bank }} {{ supplier.iban }} {{ labels.bic }} {{ supplier.bic }}</div>
  </div>
</body>
</html>

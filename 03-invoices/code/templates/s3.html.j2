<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<title>{{ doc_type_label }} {{ number }}</title>
<style>
{% include "_reset.css.j2" %}
body { font-family: {{ font_family }}; font-size: 10.5pt; color: #16130f; }
.header { display: flex; justify-content: space-between; border-bottom: 2px solid #2b2b2b;
  padding-bottom: 10pt; margin-bottom: 14pt; height: 150px; }
.company-name { font-size: 16pt; font-weight: bold; }
.company-addr { margin-top: 4pt; font-size: 9.5pt; line-height: 1.5; }
.meta-box { border: 1px solid #555; padding: 8pt 10pt; width: 250px; font-size: 9.5pt; }
.meta-box div { display: flex; justify-content: space-between; padding: 2pt 0; }
.meta-box .label { color: #444; }
.buyer-block { margin-bottom: 16pt; font-size: 9.5pt; line-height: 1.5; }
.buyer-block .kicker { font-size: 8.5pt; text-transform: uppercase; color: #555; }
table.lines th, table.lines td { padding: 8pt 6pt; text-align: left; border-bottom: 1px solid #ccc; font-size: 9.5pt; }
table.lines thead { display: table-header-group; background: #eeeae0; }
table.lines th { font-size: 8.5pt; text-transform: uppercase; color: #444; }
table.lines td.num, table.lines th.num { text-align: right; }
tr { page-break-inside: avoid; }
.totals-wrap { margin-top: 14pt; display: flex; justify-content: flex-end; height: 120px; }
.totals-box { width: 290px; font-size: 9.5pt; border: 1px solid #999; padding: 8pt 10pt; }
.totals-box div { display: flex; justify-content: space-between; padding: 2pt 0; }
.totals-box .brutto { font-weight: bold; font-size: 11.5pt; border-top: 1px solid #333; margin-top: 4pt; padding-top: 5pt; }
.mention { margin-top: 10pt; font-size: 9pt; font-style: italic; }
.footer { margin-top: 22pt; border-top: 1px solid #999; padding-top: 8pt; font-size: 8.5pt;
  color: #333; }
.footer .heading { font-weight: bold; margin-bottom: 3pt; }
</style>
</head>
<body>
  <div class="header">
    <div>
      <div class="company-name">{{ supplier.name }}</div>
      <div class="company-addr">
        {{ supplier.street }}<br>
        {{ supplier.postcode }} {{ supplier.city }}, Deutschland<br>
        {{ supplier.business_id }}<br>
        {{ labels.vat_id }} {{ supplier.vat_id }}
      </div>
    </div>
    <div class="meta-box">
      <div><span class="label">{{ doc_type_label }}-Nr.</span><span>{{ number }}</span></div>
      <div><span class="label">{{ labels.issue_date }}</span><span>{{ issue_date }}</span></div>
      {% if supply_date %}<div><span class="label">{{ labels.supply_date }}</span><span>{{ supply_date }}</span></div>{% endif %}
      {% if due_date %}<div><span class="label">{{ labels.due_date }}</span><span>{{ due_date }}</span></div>{% endif %}
      {% if po_number %}<div><span class="label">{{ labels.po_number }}</span><span>{{ po_number }}</span></div>{% endif %}
      {% if original_invoice_number %}<div><span class="label">{{ labels.original_invoice }}</span><span>{{ original_invoice_number }}</span></div>{% endif %}
    </div>
  </div>

  <div class="buyer-block">
    <div class="kicker">{{ labels.buyer }}</div>
    {{ buyer.name }}<br>
    {{ buyer.street }}<br>
    {{ buyer.postcode }} {{ buyer.city }}, Finnland<br>
    {{ labels.business_id }}: {{ buyer.business_id }}
    {% if buyer.vat_id %}<br>{{ labels.vat_id }}: {{ buyer.vat_id }}{% endif %}
  </div>

  <table class="lines">
    <thead><tr>
      <th>{{ labels.description }}</th>
      <th class="num">{{ labels.quantity }}</th>
      <th>{{ labels.unit }}</th>
      <th class="num">{{ labels.unit_price }}</th>
      <th class="num">{{ labels.vat_rate }}</th>
      <th class="num">{{ labels.line_total }}</th>
    </tr></thead>
    <tbody>
      {% for line in page1_lines %}
      <tr>
        <td>{{ line.description }}</td>
        <td class="num">{{ line.quantity }}</td>
        <td>{{ line.unit }}</td>
        <td class="num">{{ line.unit_price }}</td>
        <td class="num">{{ line.vat_rate }}</td>
        <td class="num">{{ line.line_total }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if page2_lines %}
  <div class="page-break-before">
    <div class="continuation-note">{{ doc_type_label }} {{ number }} ({{ labels.continued }})</div>
    <table class="lines">
      <thead><tr>
        <th>{{ labels.description }}</th>
        <th class="num">{{ labels.quantity }}</th>
        <th>{{ labels.unit }}</th>
        <th class="num">{{ labels.unit_price }}</th>
        <th class="num">{{ labels.vat_rate }}</th>
        <th class="num">{{ labels.line_total }}</th>
      </tr></thead>
      <tbody>
        {% for line in page2_lines %}
        <tr>
          <td>{{ line.description }}</td>
          <td class="num">{{ line.quantity }}</td>
          <td>{{ line.unit }}</td>
          <td class="num">{{ line.unit_price }}</td>
          <td class="num">{{ line.vat_rate }}</td>
          <td class="num">{{ line.line_total }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="totals-wrap">
    <div class="totals-box">
      <div><span>{{ labels.net }}</span><span>{{ totals.net }} {{ currency_suffix }}</span></div>
      <div><span>{{ labels.vat }} {{ vat_summary[0].rate }} %</span><span>{{ totals.vat }} {{ currency_suffix }}</span></div>
      <div class="brutto"><span>{{ labels.gross }}</span><span>{{ totals.gross }} {{ currency_suffix }}</span></div>
    </div>
  </div>

  {% if reverse_charge_mention %}<div class="mention">{{ reverse_charge_mention }}</div>{% endif %}

  <div class="footer">
    <div class="heading">Bankverbindung</div>
    IBAN: {{ supplier.iban }} &nbsp; BIC: {{ supplier.bic }}
    {% if payment_terms_label %}<br>{{ labels.payment_terms }}: {{ payment_terms_label }}{% endif %}
    {% if reference_value is none %}<br>Verwendungszweck: {{ number }}{% endif %}
  </div>
</body>
</html>

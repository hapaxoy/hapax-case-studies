<!doctype html>
<html lang="fi">
<head>
<meta charset="utf-8">
<title>{{ doc_type_label }} {{ number }}</title>
<style>
{% include "_reset.css.j2" %}
body { font-family: {{ font_family }}; font-size: 10.5pt; color: #171410; }
.header { display: flex; justify-content: space-between; border-bottom: 2px solid #333;
  padding-bottom: 10pt; margin-bottom: 14pt; height: 150px; }
.company-name { font-size: 15pt; font-weight: bold; }
.company-addr { margin-top: 4pt; font-size: 9.5pt; line-height: 1.5; }
.meta-box { border: 1px solid #666; padding: 8pt 10pt; width: 220px; font-size: 9.5pt; }
.meta-box div { display: flex; justify-content: space-between; padding: 2pt 0; }
.meta-box .label { color: #444; }
.buyer-block { margin-bottom: 16pt; font-size: 9.5pt; line-height: 1.5; }
.buyer-block .kicker { font-size: 8.5pt; text-transform: uppercase; color: #555; }
table.lines th, table.lines td { padding: 7pt 6pt; text-align: left; border-bottom: 1px solid #ccc; font-size: 9.5pt; }
table.lines th { font-size: 8.5pt; text-transform: uppercase; color: #444; }
table.lines td.num, table.lines th.num { text-align: right; }
.totals-wrap { margin-top: 14pt; display: flex; justify-content: flex-end; }
.totals-box { width: 260px; font-size: 9.5pt; }
.totals-box div { display: flex; justify-content: space-between; padding: 2pt 0; }
.totals-box .gross { font-weight: bold; font-size: 11pt; border-top: 1px solid #333; margin-top: 4pt; padding-top: 5pt; }
.mention { margin-top: 10pt; font-size: 9pt; }
.footer { margin-top: 20pt; border-top: 1px solid #999; padding-top: 8pt; font-size: 8.5pt; color: #333; }
</style>
</head>
<body>
  <div class="header">
    <div>
      <div class="company-name">{{ supplier.name }}</div>
      <div class="company-addr">
        {{ supplier.street }}<br>
        {{ supplier.postcode }} {{ supplier.city }}<br>
        {{ labels.business_id }}: {{ supplier.business_id }}
      </div>
    </div>
    <div class="meta-box">
      <div><span class="label">{{ doc_type_label }}</span><span>{{ number }}</span></div>
      <div><span class="label">{{ labels.issue_date }}</span><span>{{ issue_date }}</span></div>
      {% if due_date %}<div><span class="label">{{ labels.due_date }}</span><span>{{ due_date }}</span></div>{% endif %}
      {% if po_number %}<div><span class="label">{{ labels.po_number }}</span><span>{{ po_number }}</span></div>{% endif %}
    </div>
  </div>

  <div class="buyer-block">
    <div class="kicker">{{ labels.buyer }}</div>
    {{ buyer.name }}<br>
    {{ buyer.street }}<br>
    {{ buyer.postcode }} {{ buyer.city }}<br>
    {{ labels.business_id }}: {{ buyer.business_id }}
  </div>

  <table class="lines">
    <tr><th>{{ labels.description }}</th><th class="num">{{ labels.quantity }}</th><th>{{ labels.unit }}</th><th class="num">{{ labels.unit_price }}</th><th class="num">{{ labels.vat_rate }}</th><th class="num">{{ labels.line_total }}</th></tr>
    {% for line in lines %}
    <tr><td>{{ line.description }}</td><td class="num">{{ line.quantity }}</td><td>{{ line.unit }}</td><td class="num">{{ line.unit_price }}</td><td class="num">{{ line.vat_rate }}</td><td class="num">{{ line.line_total }}</td></tr>
    {% endfor %}
  </table>

  <div class="totals-wrap">
    <div class="totals-box">
      <div><span>{{ labels.net }}</span><span>{{ totals.net }} {{ currency_suffix }}</span></div>
      <div><span>{{ labels.vat }} {{ vat_summary[0].rate }} %</span><span>{{ totals.vat }} {{ currency_suffix }}</span></div>
      <div class="gross"><span>{{ labels.gross }}</span><span>{{ totals.gross }} {{ currency_suffix }}</span></div>
    </div>
  </div>

  {% if reverse_charge_mention %}<div class="mention">{{ reverse_charge_mention }}</div>{% endif %}

  <div class="footer">
    {{ labels.business_id }} {{ supplier.business_id }} -- {{ labels.vat_id }} {{ supplier.vat_id }}<br>
    {% if payment_terms_label %}{{ labels.payment_terms }}: {{ payment_terms_label }}<br>{% endif %}
    {{ labels.bank }}: {{ supplier.iban }} &nbsp; {{ labels.bic }}: {{ supplier.bic }}
  </div>
</body>
</html>

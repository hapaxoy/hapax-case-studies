<!doctype html>
<html lang="fi">
<head>
<meta charset="utf-8">
<title>{{ doc_type_label }} {{ number }}</title>
<style>
{% include "_reset.css.j2" %}
body { font-family: {{ font_family }}; font-size: 10.5pt; color: #171410; }
.header { padding-bottom: 10pt; border-bottom: 1px solid #333; margin-bottom: 12pt; height: 150px; }
.company-name { font-size: 16pt; font-weight: bold; }
.company-addr { margin-top: 3pt; font-size: 9.5pt; }
.meta-strip { margin-top: 10pt; display: flex; gap: 24pt; font-size: 9.5pt; border-top: 1px solid #ccc;
  border-bottom: 1px solid #ccc; padding: 6pt 0; }
.meta-strip .item .label { display: block; font-size: 8pt; text-transform: uppercase; color: #666; }
.buyer-block { margin: 14pt 0 16pt; font-size: 9.5pt; line-height: 1.5; }
.buyer-block .kicker { font-size: 8.5pt; text-transform: uppercase; color: #555; }
table.lines th, table.lines td { padding: 7pt 6pt; text-align: left; border-bottom: 1px solid #ccc; font-size: 9.5pt; }
table.lines th { font-size: 8.5pt; text-transform: uppercase; color: #444; border-bottom: 2px solid #333; }
table.lines td.num, table.lines th.num { text-align: right; }
.totals-wrap { margin-top: 14pt; }
.totals-box { width: 260px; margin-left: auto; font-size: 9.5pt; }
.totals-box div { display: flex; justify-content: space-between; padding: 2pt 0; }
.totals-box .gross { font-weight: bold; font-size: 11pt; border-top: 1px solid #333; margin-top: 4pt; padding-top: 5pt; }
.mention { margin-top: 10pt; font-size: 9pt; }
.footer { margin-top: 20pt; font-size: 8.5pt; color: #444; }
</style>
</head>
<body>
  <div class="header">
    <div class="company-name">{{ supplier.name }}</div>
    <div class="company-addr">{{ supplier.street }}, {{ supplier.postcode }} {{ supplier.city }} &middot; {{ labels.business_id }} {{ supplier.business_id }}</div>
    <div class="meta-strip">
      <div class="item"><span class="label">{{ doc_type_label }}</span>{{ number }}</div>
      <div class="item"><span class="label">{{ labels.issue_date }}</span>{{ issue_date }}</div>
      {% if due_date %}<div class="item"><span class="label">{{ labels.due_date }}</span>{{ due_date }}</div>{% endif %}
      {% if po_number %}<div class="item"><span class="label">{{ labels.po_number }}</span>{{ po_number }}</div>{% endif %}
    </div>
  </div>

  <div class="buyer-block">
    <div class="kicker">{{ labels.buyer }}</div>
    {{ buyer.name }}, {{ buyer.street }}, {{ buyer.postcode }} {{ buyer.city }} ({{ labels.business_id }} {{ buyer.business_id }})
  </div>

  <table class="lines">
    <tr><th>{{ labels.description }}</th><th class="num">{{ labels.quantity }}</th><th>{{ labels.unit }}</th><th class="num">{{ labels.unit_price }}</th><th class="num">{{ labels.vat_rate }}</th><th class="num">{{ labels.line_total }}</th></tr>
    {% for line in lines %}
    <tr><td>{{ line.description }}</td><td class="num">{{ line.quantity }}</td><td>{{ line.unit }}</td><td class="num">{{ line.unit_price }}</td><td class="num">{{ line.vat_rate }}</td><td class="num">{{ line.line_total }}</td></tr>
    {% endfor %}
  </table>

  <div class="totals-wrap">
    <div class="totals-box">
      <div><span>{{ labels.net }}</span><span>{{ totals.net }} {{ currency_suffix }}</span></div>
      <div><span>{{ labels.vat }} {{ vat_summary[0].rate }} %</span><span>{{ totals.vat }} {{ currency_suffix }}</span></div>
      <div class="gross"><span>{{ labels.gross }}</span><span>{{ totals.gross }} {{ currency_suffix }}</span></div>
    </div>
  </div>

  {% if reverse_charge_mention %}<div class="mention">{{ reverse_charge_mention }}</div>{% endif %}

  <div class="footer">
    {{ labels.vat_id }} {{ supplier.vat_id }} {% if payment_terms_label %}&middot; {{ labels.payment_terms }}: {{ payment_terms_label }} {% endif %}&middot; {{ labels.bank }} {{ supplier.iban }} &middot; {{ labels.bic }} {{ supplier.bic }}
  </div>
</body>
</html>

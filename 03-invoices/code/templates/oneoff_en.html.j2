<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<title>{{ doc_type_label }} {{ number }}</title>
<style>
{% include "_reset.css.j2" %}
body { font-family: {{ font_family }}; font-size: 10.5pt; color: #16130f; }
.header { border-bottom: 2px solid #333; padding-bottom: 10pt; margin-bottom: 14pt; height: 150px; }
.company-name { font-size: 15pt; font-weight: bold; }
.company-addr { margin-top: 4pt; font-size: 9.5pt; line-height: 1.5; }
.meta-strip { margin-top: 10pt; font-size: 9.5pt; line-height: 1.8; }
.meta-strip span.label { display: inline-block; width: 140px; color: #444; }
.buyer-block { margin-bottom: 16pt; font-size: 9.5pt; line-height: 1.5; }
.buyer-block .kicker { font-size: 8.5pt; text-transform: uppercase; color: #555; }
table.lines th, table.lines td { padding: 7pt 6pt; text-align: left; border-bottom: 1px solid #ccc; font-size: 9.5pt; }
table.lines th { font-size: 8.5pt; text-transform: uppercase; color: #444; border-bottom: 2px solid #333; }
table.lines td.num, table.lines th.num { text-align: right; }
.totals-wrap { margin-top: 14pt; }
.totals-box { width: 260px; margin-left: auto; font-size: 9.5pt; }
.totals-box div { display: flex; justify-content: space-between; padding: 2pt 0; }
.totals-box .gross { font-weight: bold; border-top: 1px solid #333; margin-top: 4pt; padding-top: 5pt; }
.mention { margin-top: 10pt; font-size: 9pt; font-weight: bold; }
.footer { margin-top: 20pt; font-size: 8.5pt; color: #333; }
</style>
</head>
<body>
  <div class="header">
    <div class="company-name">{{ supplier.name }}</div>
    <div class="company-addr">{{ supplier.street }}, {{ supplier.postcode }} {{ supplier.city }}, {{ supplier.country_name }} &middot; {{ labels.business_id }}: {{ supplier.business_id }}</div>
    <div class="meta-strip">
      <div><span class="label">{{ labels.invoice_number }}</span>{{ number }}</div>
      <div><span class="label">{{ labels.issue_date }}</span>{{ issue_date }}</div>
      {% if due_date %}<div><span class="label">{{ labels.due_date }}</span>{{ due_date }}</div>{% endif %}
    </div>
  </div>

  <div class="buyer-block">
    <div class="kicker">{{ labels.buyer }}</div>
    {{ buyer.name }}, {{ buyer.street }}, {{ buyer.postcode }} {{ buyer.city }}, Finland<br>
    {{ labels.business_id }}: {{ buyer.business_id }}
    {% if buyer.vat_id %}<br>{{ labels.vat_id }}: {{ buyer.vat_id }}{% endif %}
  </div>

  <table class="lines">
    <tr><th>{{ labels.description }}</th><th class="num">{{ labels.quantity }}</th><th>{{ labels.unit }}</th><th class="num">{{ labels.unit_price }}</th><th class="num">{{ labels.line_total }}</th></tr>
    {% for line in lines %}
    <tr><td>{{ line.description }}</td><td class="num">{{ line.quantity }}</td><td>{{ line.unit }}</td><td class="num">{{ line.unit_price }}</td><td class="num">{{ line.line_total }}</td></tr>
    {% endfor %}
  </table>

  <div class="totals-wrap">
    <div class="totals-box">
      <div><span>{{ labels.net }}</span><span>{{ totals.net }} {{ currency_suffix }}</span></div>
      <div><span>{{ labels.vat }} {{ vat_summary[0].rate }} %</span><span>{{ totals.vat }} {{ currency_suffix }}</span></div>
      <div class="gross"><span>{{ labels.gross }}</span><span>{{ totals.gross }} {{ currency_suffix }}</span></div>
    </div>
  </div>

  {% if reverse_charge_mention %}<div class="mention">{{ reverse_charge_mention }}</div>{% endif %}

  <div class="footer">
    {% if payment_terms_label %}{{ labels.payment_terms }}: {{ payment_terms_label }}<br>{% endif %}
    {{ labels.bank }}: IBAN {{ supplier.iban }}, {{ labels.bic }} {{ supplier.bic }}<br>
    {{ labels.vat_id }}: {{ supplier.vat_id }} &middot; {{ labels.business_id }}: {{ supplier.business_id }}
  </div>
</body>
</html>

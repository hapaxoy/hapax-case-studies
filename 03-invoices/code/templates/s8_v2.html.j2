<!doctype html>
<html lang="fi">
<head>
<meta charset="utf-8">
<title>{{ doc_type_label }} {{ number }}</title>
<style>
{% include "_reset.css.j2" %}
body { font-family: {{ font_family }}; font-size: 10.5pt; color: #171410; }
.band { background: #2c2620; color: #f4efdd; padding: 12pt 16pt; margin-bottom: 16pt;
  display: flex; justify-content: space-between; align-items: center; height: 150px; }
.band .company-name { font-size: 16pt; font-weight: bold; }
.band .company-addr { margin-top: 4pt; font-size: 9pt; line-height: 1.5; color: #d8d0bd; }
.band .meta-grid { display: grid; grid-template-columns: auto auto; gap: 2pt 14pt; font-size: 9.5pt; }
.band .meta-grid .label { color: #c9c0a8; }
.buyer-block { margin-bottom: 16pt; font-size: 9.5pt; line-height: 1.5; }
.buyer-block .kicker { font-size: 8.5pt; text-transform: uppercase; color: #555; }
table.lines th, table.lines td { padding: 8pt 6pt; text-align: left; border-bottom: 1px solid #ccc; font-size: 9.5pt; }
table.lines thead { display: table-header-group; background: #2c2620; color: #f4efdd; }
table.lines th { font-size: 8.5pt; text-transform: uppercase; }
table.lines td.num, table.lines th.num { text-align: right; }
table.lines td.code { font-family: 'Courier New', monospace; font-size: 8.5pt; color: #555; }
tr { page-break-inside: avoid; }
.totals-wrap { margin-top: 14pt; display: flex; justify-content: flex-start; height: 110px; }
.totals-box { width: 270px; font-size: 9.5pt; }
.totals-box div { display: flex; justify-content: space-between; padding: 2pt 0; }
.totals-box .gross { font-weight: bold; font-size: 11.5pt; border-top: 1px solid #333; margin-top: 4pt; padding-top: 5pt; }
.footer { margin-top: 22pt; border-top: 1px solid #999; padding-top: 8pt; font-size: 8.5pt; color: #333; }
</style>
</head>
<body>
  <div class="band">
    <div>
      <div class="company-name">{{ supplier.name }}</div>
      <div class="company-addr">{{ supplier.street }}, {{ supplier.postcode }} {{ supplier.city }} &middot; {{ labels.business_id }} {{ supplier.business_id }}</div>
    </div>
    <div class="meta-grid">
      <span class="label">{{ doc_type_label }}</span><span>{{ number }}</span>
      <span class="label">{{ labels.issue_date }}</span><span>{{ issue_date }}</span>
      {% if due_date %}<span class="label">{{ labels.due_date }}</span><span>{{ due_date }}</span>{% endif %}
      {% if reference_value %}<span class="label">{{ labels.reference }}</span><span>{{ reference_value }}</span>{% endif %}
      {% if po_number %}<span class="label">{{ labels.po_number }}</span><span>{{ po_number }}</span>{% endif %}
    </div>
  </div>

  <div class="buyer-block">
    <div class="kicker">{{ labels.buyer }}</div>
    {{ buyer.name }}<br>
    {{ buyer.street }}<br>
    {{ buyer.postcode }} {{ buyer.city }}<br>
    {{ labels.business_id }}: {{ buyer.business_id }}
  </div>

  <table class="lines">
    <thead><tr>
      <th>Nimikekoodi</th>
      <th>{{ labels.description }}</th>
      <th class="num">{{ labels.quantity }}</th>
      <th>{{ labels.unit }}</th>
      <th class="num">{{ labels.vat_rate }}</th>
      <th class="num">{{ labels.unit_price }}</th>
      <th class="num">{{ labels.line_total }}</th>
    </tr></thead>
    <tbody>
      {% for line in page1_lines %}
      <tr>
        <td class="code">{{ line.product_code }}</td>
        <td>{{ line.description }}</td>
        <td class="num">{{ line.quantity }}</td>
        <td>{{ line.unit }}</td>
        <td class="num">{{ line.vat_rate }}</td>
        <td class="num">{{ line.unit_price }}</td>
        <td class="num">{{ line.line_total }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>

  {% if page2_lines %}
  <div class="page-break-before">
    <div class="continuation-note">{{ doc_type_label }} {{ number }} ({{ labels.continued }})</div>
    <table class="lines">
      <thead><tr>
        <th>Nimikekoodi</th>
        <th>{{ labels.description }}</th>
        <th class="num">{{ labels.quantity }}</th>
        <th>{{ labels.unit }}</th>
        <th class="num">{{ labels.vat_rate }}</th>
        <th class="num">{{ labels.unit_price }}</th>
        <th class="num">{{ labels.line_total }}</th>
      </tr></thead>
      <tbody>
        {% for line in page2_lines %}
        <tr>
          <td class="code">{{ line.product_code }}</td>
          <td>{{ line.description }}</td>
          <td class="num">{{ line.quantity }}</td>
          <td>{{ line.unit }}</td>
          <td class="num">{{ line.vat_rate }}</td>
          <td class="num">{{ line.unit_price }}</td>
          <td class="num">{{ line.line_total }}</td>
        </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
  {% endif %}

  <div class="totals-wrap">
    <div class="totals-box">
      <div><span>{{ labels.net }}</span><span>{{ totals.net }} {{ currency_suffix }}</span></div>
      <div><span>{{ labels.vat }} {{ vat_summary[0].rate }} %</span><span>{{ totals.vat }} {{ currency_suffix }}</span></div>
      <div class="gross"><span>{{ labels.gross }}</span><span>{{ totals.gross }} {{ currency_suffix }}</span></div>
    </div>
  </div>

  <div class="footer">
    {{ labels.business_id }} {{ supplier.business_id }} -- {{ labels.vat_id }} {{ supplier.vat_id }}<br>
    {% if payment_terms_label %}{{ labels.payment_terms }}: {{ payment_terms_label }} -- {{ labels.reference }}: {{ reference_value }}<br>{% endif %}
    {{ labels.bank }}: {{ supplier.iban }} &nbsp; {{ labels.bic }}: {{ supplier.bic }}
  </div>
</body>
</html>

<!doctype html>
<html lang="fi">
<head>
<meta charset="utf-8">
<title>{{ doc_type_label }} {{ number }}</title>
<style>
{% include "_reset.css.j2" %}
body { font-family: {{ font_family }}; font-size: 11pt; color: #171410; }
.wrap { max-width: 480px; }
.company-name { font-size: 15pt; font-weight: bold; margin-bottom: 2pt; }
.company-addr { font-size: 9.5pt; margin-bottom: 18pt; }
.meta { font-size: 10pt; margin-bottom: 16pt; line-height: 1.8; }
.meta span.label { display: inline-block; width: 130px; color: #444; }
table.lines { margin: 14pt 0; }
table.lines th, table.lines td { padding: 6pt 4pt; text-align: left; border-bottom: 1px solid #ccc; font-size: 10pt; }
table.lines td.num, table.lines th.num { text-align: right; }
.totals { font-size: 10pt; margin-top: 10pt; }
.totals div { display: flex; justify-content: space-between; padding: 2pt 0; width: 260px; }
.totals .gross { font-weight: bold; border-top: 1px solid #333; padding-top: 4pt; }
.footer { margin-top: 26pt; font-size: 8.5pt; color: #444; }
</style>
</head>
<body>
<div class="wrap">
  <div class="company-name">{{ supplier.name }}</div>
  <div class="company-addr">{{ supplier.street }}, {{ supplier.postcode }} {{ supplier.city }} &middot; {{ labels.business_id }} {{ supplier.business_id }}</div>

  <div class="meta">
    <div><span class="label">{{ doc_type_label }}</span>{{ number }}</div>
    <div><span class="label">{{ labels.issue_date }}</span>{{ issue_date }}</div>
    {% if due_date %}<div><span class="label">{{ labels.due_date }}</span>{{ due_date }}</div>{% endif %}
    <div><span class="label">{{ labels.buyer }}</span>{{ buyer.name }}, {{ buyer.street }}, {{ buyer.postcode }} {{ buyer.city }} ({{ labels.business_id }} {{ buyer.business_id }})</div>
    {% if reference_value %}<div><span class="label">{{ labels.reference }}</span>{{ reference_value }}</div>{% endif %}
  </div>

  <table class="lines">
    <tr><th>{{ labels.description }}</th><th class="num">{{ labels.quantity }}</th><th class="num">{{ labels.unit_price }}</th><th class="num">{{ labels.line_total }}</th></tr>
    {% for line in lines %}
    <tr><td>{{ line.description }}</td><td class="num">{{ line.quantity }} {{ line.unit }}</td><td class="num">{{ line.unit_price }}</td><td class="num">{{ line.line_total }}</td></tr>
    {% endfor %}
  </table>

  <div class="totals">
    <div><span>{{ labels.net }}</span><span>{{ totals.net }} {{ currency_suffix }}</span></div>
    <div><span>{{ labels.vat }} {{ vat_summary[0].rate }} %</span><span>{{ totals.vat }} {{ currency_suffix }}</span></div>
    <div class="gross"><span>{{ labels.gross }}</span><span>{{ totals.gross }} {{ currency_suffix }}</span></div>
  </div>

  <div class="footer">
    {{ labels.vat_id }} {{ supplier.vat_id }} {% if payment_terms_label %}&middot; {{ labels.payment_terms }}: {{ payment_terms_label }} {% endif %}&middot; {{ labels.bank }} {{ supplier.iban }} &middot; {{ labels.bic }} {{ supplier.bic }}
  </div>
</div>
</body>
</html>
